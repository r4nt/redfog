     pub fn notify(&self) -> &Stream::Notifier {
         &self.0.notify
     }
+
+    /// Aborts this stream's background driver task directly rather than
+    /// relying on it to notice a stop signal on its own. `StreamDriver::
+    /// poll` (this file, above) never voluntarily returns `Poll::Ready(Ok(
+    /// ()))` -- it only stops on a genuine protocol/IO error -- so nothing
+    /// about a normal `stop()`/`Drop` ever makes it exit; the `notify()`
+    /// calls `MoonlightStream::stop()` makes only wake *callers* blocked on
+    /// `poll_frame()`/`poll_packet()` (which explicitly check `is_stopped()`
+    /// after waking), not this task. Left unaborted, the task runs forever,
+    /// which is fatal specifically inside a `#[tokio::test]`: a panicking
+    /// test's `Runtime` gets dropped during unwind, and dropping a runtime
+    /// waits for every still-running spawned task -- confirmed live, a real
+    /// CI job burned its entire 30-minute budget this way after an
+    /// otherwise cleanly-bounded test assertion failure, because this
+    /// stream's video driver task kept running (and logging once a second)
+    /// long after the test itself had already failed and unwound.
+    pub fn abort_driver(&self) {
+        if let Some(handle) = self.0.join_handle.lock().expect("abort_driver").take() {
+            handle.abort();
+        }
+    }
 }
 
